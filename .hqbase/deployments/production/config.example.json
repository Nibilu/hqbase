{
  "environment": "production",
  "cloudflare": {
    "accountName": "<confirm in Cloudflare dashboard>",
    "accountId": "<keep in local secrets only>",
    "apiTokenSecret": "CLOUDFLARE_API_TOKEN",
    "accountIdSecret": "CLOUDFLARE_ACCOUNT_ID"
  },
  "worker": {
    "name": "hqbase-prod",
    "workersDev": "hqbase-prod.<account-subdomain>.workers.dev",
    "customDomain": "do.luciia.net"
  },
  "d1": {
    "name": "hqbase-prod",
    "id": "<populate after authenticated D1 list/create>"
  },
  "r2": {
    "bucket": "hqbase-prod-mail",
    "lifecycle": {
      "policy": "retain by default; delete only through an approved retention change",
      "retentionDays": null
    }
  },
  "secrets": {
    "runtime": ["BETTER_AUTH_SECRET"],
    "deployment": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
  },
  "agpl": {
    "licensePath": "/LICENSE",
    "noticePath": "/NOTICE",
    "sourceUrl": "https://github.com/Nibilu/hqbase"
  }
}
